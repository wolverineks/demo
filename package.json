{
  "name": "edge-react-hooks",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "MIT",
  "main": "src/index.tsx",
  "scripts": {
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "build": "react-scripts build",
    "eject": "react-scripts eject",
    "format": "prettier --write",
    "lint": "yarn eslint --fix --ext .js,.jsx,.ts,.tsx",
    "precommit": "yarn lint-staged && tsc",
    "serve": "serve -s build",
    "postinstall": "node scripts/patch-edge-core-fake-world.js && node scripts/patch-accountbased-browser.js",
    "start": "react-scripts start",
    "test": "react-scripts test --env=jsdom"
  },
  "husky": {
    "hooks": {
      "pre-commit": "yarn precommit"
    }
  },
  "lint-staged": {
    "*.{css}": [
      "yarn format"
    ],
    "*.{md}": [
      "yarn format"
    ],
    "*.{ts,tsx,js,jsx,json}": [
      "yarn lint",
      "yarn format"
    ]
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "resolutions": {
    "@types/lodash": "4.14.191"
  },
  "dependencies": {
    "bootstrap": "^5.1.3",
    "disklet": "^0.5.0",
    "edge-core-js": "0.19.50",
    "edge-currency-accountbased": "0.11.4",
    "edge-currency-bitcoin": "4.9.23",
    "edge-currency-monero": "^0.2.10",
    "edge-exchange-plugins": "0.16.17",
    "react": "^17.0.2",
    "react-bootstrap": "^1.6.0",
    "react-date-picker": "^8.3.5",
    "react-dom": "^17.0.2",
    "react-error-boundary": "^3.1.4",
    "react-idle-timer": "^4.6.4",
    "react-json-pretty": "^2.2.0",
    "react-qr-code": "^1.1.1",
    "react-qr-scanner": "kybarg/react-qr-scanner",
    "react-query": "^3.33.1",
    "stop-runaway-react-effects": "^2.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.15.0",
    "@testing-library/react": "^12.1.2",
    "@testing-library/react-hooks": "^7.0.2",
    "@types/jest": "^27.0.3",
    "@typescript-eslint/eslint-plugin": "^5.4.0",
    "@typescript-eslint/parser": "^5.4.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jest": "^25.2.4",
    "eslint-plugin-react": "^7.27.0",
    "eslint-plugin-react-hooks": "^4.3.0",
    "eslint-plugin-unused-imports": "^2.0.0",
    "husky": "^6.0.0",
    "import-sort-style-module": "^6.0.0",
    "lint-staged": "^11.0.0",
    "prettier": "^2.4.1",
    "prettier-plugin-import-sort": "^0.0.7",
    "prettier-plugin-packagejson": "^2.2.15",
    "react-scripts": "^4.0.3",
    "typescript": "^4.5.2",
    "typescript-coverage-report": "^0.6.1"
  }
}
